# Copy to .env.local and fill in. Every variable is optional: anything left empty falls back to sample mode.
# All of these are read only on the server. Never prefix them with NEXT_PUBLIC_.

# OpenAI: enables real drafting (Responses API + Structured Outputs) and audio transcription.
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Local PostgreSQL: create the tables once with `npm run db:setup`. Takes priority over Supabase.
# Without DATABASE_URL or the Supabase keys, data is kept in .data/kindra-db.json.
DATABASE_URL=
# Example: DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kindra

# Urgent alerts: minutes before an unacknowledged crisis/urgent alert goes to the guidance head (use 1 for a live demo).
ESCALATE_MINUTES=15

# Supabase (later): run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: create a bot with BotFather, start a private chat with it, then put the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Microsoft Entra ID sign-in (required). App registration > Authentication > platform "Web", redirect URI:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id
ENTRA_TENANT_ID=                   # Directory (tenant) ID
ENTRA_CLIENT_ID=                   # Application (client) ID
ENTRA_CLIENT_SECRET=               # Client secret VALUE (not the secret ID)
AUTH_SECRET=                       # random string that signs the session cookie; generate with: npx auth secret
# Who may sign in, and as which Kindra user (ids from lib/seed.ts). Anyone not listed is refused.
KINDRA_USER_EMAILS=                # adviser-a=ana.reyes@apc.edu.ph,counselor=liza.cruz@apc.edu.ph,guidance-head=...

# Lets a scheduler call POST /api/alerts/escalate with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Google Drive: approved case reports are copied to this folder as Google Docs. Leave empty to turn off.
GOOGLE_DRIVE_FOLDER_ID=            # the part after /folders/ in the folder's URL
# Option 1, service account (folder must be in a Shared Drive, service account added as Content manager):
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=   # path to the service account JSON key, kept outside this folder
# Option 2, a Google account: OAuth client of type "Desktop app", then run `npm run google:token`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Gmail: email urgent alerts to the counselor and escalations to the guidance head. Sent from the Google account in
# Option 2 above (GOOGLE_OAUTH_*), which works even if Drive is off. After setting GMAIL_ALERTS=on, run
# `npm run google:token` again so the token includes Gmail send access. Emails never include the student's name,
# the concern or the note.
GMAIL_ALERTS=                      # on | (empty = off)
# Recipients default to the addresses in KINDRA_USER_EMAILS. For demos, send to test inboxes instead:
GMAIL_ALERT_TO_COUNSELOR=          # comma-separated
GMAIL_ALERT_TO_GUIDANCE_HEAD=
KINDRA_APP_URL=http://localhost:3000   # used for the link in the email

# --- MCP servers for Claude Code (.mcp.json; scripts/mcp/) ---
# postgres and telegram reuse DATABASE_URL and TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID above.
# GitHub: fine-grained token from https://github.com/settings/personal-access-tokens
# (repo access: kindra-app; permissions: Contents, Issues, Pull requests, Actions = read/write as needed)
GITHUB_PERSONAL_ACCESS_TOKEN=
