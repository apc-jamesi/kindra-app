{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "node scripts/mcp/github-headers.mjs"
    },
    "postgres": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/mcp/postgres.mjs"]
    },
    "telegram": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/mcp/telegram.mjs"]
    }
  }
}
